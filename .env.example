# Never commit the real .env
# Key that writes receipts to HSK Chain (holds a little HSK for gas only)
RECEIPT_WRITER_KEY=
# Hackathon test-network key the airline agent pays from (test USDC only)
AGENT_PAYER_KEY=
# LandedPolicy address and where it lives (mainnet unless POLICY_NETWORK=testnet)
POLICY_ADDRESS=
POLICY_NETWORK=
# Team name HSP uses to count our payments (keep it identical everywhere)
HSP_MERCHANT_NAME=Landed
# Optional: force a network from get_chain_config, e.g. base-sepolia or 84532
PAY_NETWORK=
# Demo passenger wallet shown on the site
DEMO_PASSENGER_WALLET=
# Site origins allowed to call the agent (comma separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PORT=8787
